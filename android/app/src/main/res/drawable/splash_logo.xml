<?xml version="1.0" encoding="utf-8"?>
<!-- launch animation: blue gradient circle with the white pigeon (like Telegram's start) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="315" android:startColor="#FF6CC4FF" android:endColor="#FF2B8FD6" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
