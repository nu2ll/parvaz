<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is only the background colour; our own icon animation plays right after -->
    <style name="Theme.Kabootar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty</item>
    </style>
</resources>
